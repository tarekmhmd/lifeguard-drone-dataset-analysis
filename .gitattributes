*.py linguist-language=Python
# Fixtures are compared byte for byte (generate_fixtures --check) and checksummed (models/registry.yaml):
# never convert their line endings on checkout (Windows runners default to CRLF conversion).
tests/fixtures/** -text
models/*.pt filter=lfs diff=lfs merge=lfs -text
# Notebooks hold large outputs/images; keep them out of GitHub's language bar (files stay in the repo).
*.ipynb linguist-documentation linguist-vendored linguist-detectable=false

artifacts/pose/weights/**/*.pt filter=lfs diff=lfs merge=lfs -text

artifacts/pose/weights/**/*.pt filter=lfs diff=lfs merge=lfs -text
